# Application
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=nandi
DB_PASSWORD=nandi
DB_NAME=nandi
DB_SSLMODE=disable
# Optional DSN override. When set, the split DB_* fields above are ignored.
# DATABASE_URL=postgres://nandi:nandi@localhost:5432/nandi?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (used from Prompt 1.2 onward — do not commit real secrets)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
